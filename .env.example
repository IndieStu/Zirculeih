DJANGO_SECRET_KEY=GENERATE_A_RANDOM_SECRET
# Explicit operator rotation only: JSON list of separately protected old signing keys.
DJANGO_SECRET_KEY_FALLBACKS=[]
POSTGRES_PASSWORD=GENERATE_A_DATABASE_PASSWORD
POSTGRES_DB=deelvo
POSTGRES_USER=deelvo
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=false
# Local HTTP only. For TLS proxy operation see docs/DEVELOPMENT.md.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Deelvo URLs / SMTP. Replace examples for the actual installation; no secrets in Git.
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
# Registration stays closed until the organization supplies its privacy notice/version.
PRIVACY_NOTICE_TEXT=
PRIVACY_NOTICE_VERSION=
# Implemented staff comfort login; enable after configuring the organization's Authentik app.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_ENDPOINT=
